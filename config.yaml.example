ollama:
  host: http://localhost:11434
  models_dir: ~/infra/ai/models/ollama
  models:
    - gemma4:26b
    - qwen3.6:27b
    - qwen3.6-uncensored:latest
    - gpt-oss:20b
    - devstral-small-2:24b
    - deepseek-r1:14b

llama_server:
  host: http://localhost:8090
  bin: ~/infra/bin/llama-server
  gguf_dir: ~/infra/ai/models/gguf
  mmproj_dir: ~/infra/ai/models/mmproj
  quant: Q4_K_M
  slot_1_port: 8090
  slot_2_port: 8091
  # gtt_bytes: <capacity in bytes>  # Optional override when Linux sysfs is unavailable
  perplexity:
    bin: ~/infra/bin/llama-perplexity
    dataset: ~/infra/ai/models/datasets/wikitext-2-raw/wiki.test.raw

profiles:
  # llama-server profiles: all server flags go in 'flags' — nothing is hardcoded.
  # Flags injected by auriga: -m <model>, --host 0.0.0.0, --port <N>, --ctx-size <N>, --mmproj <path>
  qwen3.6-27b:
    type: dense
    repo: unsloth/Qwen3.6-27B-GGUF
    model: Qwen3.6-27B-UD-Q8_K_XL.gguf
    mmproj: mmproj-F32.gguf
    flags: [--flash-attn, "on", --gpu-layers, "99", --metrics, --slots, --cache-type-k, q8_0, --cache-type-v, q8_0, --batch-size, "2048", --ubatch-size, "512", --threads, "16"]
  gemma4-26b:
    type: moe
    repo: unsloth/gemma-4-26B-A4B-it-GGUF
    model: gemma-4-26B-A4B-it-UD-Q4_K_M.gguf
    flags: [--flash-attn, "on", --gpu-layers, "99", --metrics, --slots]

  # vLLM profile: uses 'backend: vllm' and 'model_dir' instead of 'model' (GGUF).
  # Flags injected by auriga: serve <model_dir>, --host 0.0.0.0, --port <N>, --max-model-len <N>
  # gemma4-26b-ciru-vllm:
  #   backend: vllm
  #   type: moe
  #   repo: jcbtc/Gemma4-26B-CIRU-AMD-STRIX-vLLM
  #   model_dir: ~/infra/ai/models/hf/gemma4-ciru-strix
  #   flags: [--language-model-only, --max-num-seqs, "8", --max-num-batched-tokens, "2048", --enable-prefix-caching]
  #   ctx_size: 8192

benchmark:
  max_tokens: 32768
  max_retries: 5
  gen_timeout: 3600
  results_dir: ~/Projects/auriga-lab/results
